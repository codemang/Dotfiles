# Below are the color init strings for the basic file types. A color init
# string consists of one or more of the following numeric codes:
# Attribute codes:
# 00=none 01=bold 04=underscore 05=blink 07=reverse 08=concealed
# Text color codes:
# 30=black 31=red 32=green 33=yellow 34=blue 35=magenta 36=cyan 37=white
# Background color codes:
# 40=black 41=red 42=green 43=yellow 44=blue 45=magenta 46=cyan 47=white
#NORMAL 00 # no color code at all
#FILE 00 # regular file: use no color at all
RESET 0 # reset to "normal" color
# Colors below match macOS's LSCOLORS=GxBxhxDxfxhxhxhxhxcxcx (set in
# shell_scripts/zsh_shell_initializer.zsh), so ls looks the same in iTerm and
# over SSH.
DIR 01;36 # directory (G: bold cyan)
LINK 01;31 # symbolic link (B: bold red)
MULTIHARDLINK 00 # regular file with more than one link
FIFO 01;33 # pipe (D: bold yellow)
SOCK 37 # socket (h: light grey)
DOOR 37 # door
BLK 37 # block device driver (h: light grey)
CHR 37 # character device driver (h: light grey)
ORPHAN 01;31 # symlink to nonexistent file (macOS colors it like a symlink)
MISSING 00 # ... and the files they point to
SETUID 37 # file that is setuid (u+s) (h: light grey)
SETGID 37 # file that is setgid (g+s) (h: light grey)
CAPABILITY 00 # file with capability (macOS has no equivalent)
STICKY_OTHER_WRITABLE 32 # dir that is sticky and other-writable (+t,o+w) (c: green)
OTHER_WRITABLE 32 # dir that is other-writable (o+w) and not sticky (c: green)
STICKY 01;36 # dir with the sticky bit set (+t) and not other-writable (macOS colors it like a directory)
# This is for files with execute permission:
EXEC 35 # (f: magenta)
# macOS doesn't color files by extension, so there are no extension rules.
