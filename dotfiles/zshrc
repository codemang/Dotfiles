#!/usr/local/bin/zsh

# Set global ENV vars.
export ZSH=$HOME/.oh-my-zsh
export HISTCONTROL=ignoreboth:erasedupsG
export DOTFILES=${${(%):-%x}:A:h:h}

[ -f ~/.before_init_private_scripts.sh ] && source ~/.before_init_private_scripts.sh

source $DOTFILES/dotfiles/shell_scripts/dev_box_entrypoint.sh

# Create prompt
source $DOTFILES/dotfiles/shell_scripts/zshrc_prompt

# Zsh shell initializer
source $DOTFILES/dotfiles/shell_scripts/zsh_shell_initializer.zsh

[ -f ~/.private_scripts.sh ] && source ~/.private_scripts.sh
