#!/bin/bash

[ -f ~/.before_init_private_scripts.sh ] && source ~/.before_init_private_scripts.sh

# Repo root, found by this file's path (sourced from ~/.bashrc, or ~/.profile symlinked here).
export DOTFILES=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
source $DOTFILES/shell_scripts/dev_box_entrypoint.sh

# Create prompt
source $DOTFILES/shell_scripts/bash_prompt

[ -f ~/.private_scripts.zsh ] && source ~/.private_scripts.zsh
